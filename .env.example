# URL del Webhook de Make (o Slack) para enviar las alertas cuando un sitio caiga
MAKE_ALERT_WEBHOOK="https://hook.us2.make.com/tu_webhook_aqui"

# Configuración de sitios en formato JSON (array de objetos)
# Cada objeto debe tener:
# - client: Nombre del cliente o sitio
# - url: URL completa con https://
# - type: Tipo de sitio ("wordpress" para validar errores específicos de WP, o "standard" para solo validar status code)
SITES_CONFIG='[{"client": "Cliente Ejemplo 1", "url": "https://ejemplo1.com/", "type": "wordpress"}, {"client": "Cliente Ejemplo 2", "url": "https://ejemplo2.com/", "type": "standard"}]'
