# URL del Webhook de Make (o Slack) para enviar las alertas cuando un sitio caiga
MAKE_ALERT_WEBHOOK="https://hook.us2.make.com/tu_webhook_aqui"

# (Opcional) Parámetros globales de rendimiento y reintentos:
# CHECK_TIMEOUT=30        # Segundos máximos de espera por sitio (default: 30)
# CHECK_RETRIES=2        # Número de reintentos adicionales si un sitio falla (default: 2, total 3 intentos)
# CHECK_RETRY_DELAY=5    # Segundos base de espera entre reintentos con backoff progresivo (default: 5)

# Configuración de sitios en formato JSON (array de objetos)
# Cada objeto admite:
# - client: (Requerido) Nombre del cliente o sitio
# - url: (Requerido) URL completa con https://
# - type: (Opcional) "wordpress" para validar errores específicos de WP, o "standard" (default)
# - timeout: (Opcional) Timeout específico en segundos para sitios con CRMs o backends pesados
# - retries: (Opcional) Cantidad específica de reintentos para este sitio
SITES_CONFIG='[{"client": "Cliente Ejemplo 1", "url": "https://ejemplo1.com/", "type": "wordpress", "timeout": 35}, {"client": "Cliente Ejemplo 2", "url": "https://ejemplo2.com/", "type": "standard"}]'
